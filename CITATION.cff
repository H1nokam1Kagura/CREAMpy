  - type: article
    title: "A new product growth for model consumer durables"
    authors:
      - family-names: Bass
        given-names: Frank M.
    year: 1969
    journal: Management Science
    volume: 15
    issue: 5
    pages: 215--227
    doi: "10.1287/mnsc.15.5.215"
